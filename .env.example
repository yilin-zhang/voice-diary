# Local client only. Never commit a real key.
RUNPOD_API_KEY=
VOICE_DIARY_ENDPOINT_URL=https://YOUR_ENDPOINT_ID.api.runpod.ai

# Optional defense-in-depth key shared by the client and worker.
VOICE_DIARY_APP_TOKEN=

# Worker model configuration.
VOICE_DIARY_ASR_MODEL=Qwen/Qwen3-ASR-1.7B
VOICE_DIARY_ALIGNER_MODEL=Qwen/Qwen3-ForcedAligner-0.6B
VOICE_DIARY_EDITOR_MODEL=Qwen/Qwen3.5-35B-A3B-FP8
VOICE_DIARY_MAX_UPLOAD_BYTES=29360128
VOICE_DIARY_TEMP_DIR=/dev/shm/voice-diary
VOICE_DIARY_FAKE_MODE=0
